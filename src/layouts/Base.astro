---
import '../styles/global.css';

interface Props { title: string }
const { title } = Astro.props;
const links = [['/plan/', 'Plan'], ['/evidence/', 'Evidence'], ['/atlas/', 'Atlas'], ['/review/', 'Review']];
const here = Astro.url.pathname;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title} · Spinal Tap</title>
  </head>
  <body>
    <header class="site-nav">
      <nav aria-label="Site">
        <a class="logo" href="/"><span class="mark" aria-hidden="true"></span><span class="logo-text">Spinal Tap</span></a>
        <div class="links">
          {links.map(([href, label]) => <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a>)}
          <a class="btn search-btn" href="/search/">Search</a>
        </div>
      </nav>
    </header>
    <!-- ponytail: data-pagefind-body scopes the index to Base-rendered pages; the atlas fork's app.html has none, so it is excluded -->
    <div data-pagefind-body><slot /></div>
    <footer class="site-footer">
      <!-- ponytail: licence files live at repo root; licence-and-attribution-files story must expose them under public/ or check-links will flag these -->
      <p>
        Code <a href="/LICENSE">MIT</a> ·
        Prose <a href="/LICENSE-content.md">CC BY-SA 4.0</a> ·
        BodyParts3D data <a href="/ATTRIBUTION.md">CC BY 4.0</a>
      </p>
      <p>Spinal Tap teaches; it does not diagnose or replace a clinician.</p>
    </footer>
  </body>
</html>
<style>
  .site-nav { position: sticky; top: 0; z-index: 10; height: var(--nav-h); border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  nav { max-width: 72rem; height: 100%; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 1rem; letter-spacing: -0.2px; text-decoration: none; color: var(--text); white-space: nowrap; }
  .mark { width: 18px; height: 18px; border-radius: 6px; background: linear-gradient(180deg, var(--brand) 0 22%, transparent 22% 39%, var(--brand) 39% 61%, transparent 61% 78%, var(--brand) 78%); }
  .links { display: flex; align-items: center; gap: 4px; overflow-x: auto; scrollbar-width: none; }
  .links a:not(.btn) { padding: 5px 10px; border-radius: 8px; font-size: 0.875rem; font-weight: 500; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .links a:not(.btn):hover, .links a[aria-current='page'] { color: var(--text); background: var(--hover); }
  .search-btn { margin-left: 8px; padding: 4px 14px; font-size: 0.875rem; }
  .site-footer { max-width: 46rem; margin: 0 auto; padding: 24px 24px 48px; border-top: 1px solid var(--border-3); font-size: 0.8125rem; color: var(--muted); }
  .site-footer p { margin: 4px 0; }
  .site-footer a { color: var(--muted); }
  @media (max-width: 640px) {
    nav { padding: 0 16px; }
    .search-btn { margin-left: 2px; }
    .links a:not(.btn) { padding: 5px 7px; }
  }
  @media (max-width: 480px) {
    .logo-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
</style>
