---
interface Props { title: string }
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Spinal Tap</title>
  </head>
  <body>
    <nav class="site-nav" aria-label="Site"><a href="/">Spinal Tap</a> · <a href="/plan/">Plan</a> · <a href="/evidence/">Evidence</a> · <a href="/atlas/">Atlas</a> · <a href="/review/">Review</a> · <a href="/search/">Search</a></nav>
    <!-- ponytail: data-pagefind-body scopes the index to Base-rendered pages; the atlas fork's app.html has none, so it is excluded -->
    <div data-pagefind-body><slot /></div>
    <footer class="site-footer">
      <!-- ponytail: licence files live at repo root; licence-and-attribution-files story must expose them under public/ or check-links will flag these -->
      <p>
        Code <a href="/LICENSE">MIT</a> ·
        Prose <a href="/LICENSE-content.md">CC BY-SA 4.0</a> ·
        BodyParts3D data <a href="/ATTRIBUTION.md">CC BY 4.0</a>
      </p>
      <p>Spinal Tap teaches; it does not diagnose or replace a clinician.</p>
    </footer>
  </body>
</html>
<style is:global>
  body { font-family: system-ui, sans-serif; line-height: 1.6; margin: 0; color: #1f2937; }
</style>
<style>
  .site-footer { max-width: 44rem; margin: 3rem auto 0; padding: 1rem; border-top: 1px solid #e5e7eb; font-size: 0.85rem; color: #6b7280; }
  .site-footer p { margin: 0.25rem 0; }
  .site-nav { max-width: 44rem; margin: 0 auto; padding: 0.75rem 1rem 0; font-size: 0.9rem; color: #6b7280; }
</style>
