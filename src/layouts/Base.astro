---
import '../styles/global.css';

interface Props { title: string; footer?: boolean } // footer=false for a page that fills the viewport (/atlas/)
const { title, footer = true } = Astro.props;
const links = [['/learn/', 'Learn'], ['/plan/', 'Plan'], ['/evidence/', 'Evidence'], ['/atlas/', 'Atlas'], ['/templates/', 'Templates']];
const here = Astro.url.pathname;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title} · Spinal Tap</title>
    <script is:inline>
      // Runs before first paint so a pinned theme never flashes. No stored choice means follow the OS.
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <header class="site-nav">
      <nav aria-label="Site">
        <a class="logo" href="/"><span class="mark" aria-hidden="true"></span><span class="logo-text">Spinal Tap</span></a>
        <div class="links">
          {links.map(([href, label]) => <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a>)}
          <a class="btn search-btn" href="/search/">Search</a>
        </div>
        <a class="icon-btn" href="/settings/" aria-label="Settings" aria-current={here.startsWith('/settings/') ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" /></svg>
        </a>
        <button type="button" class="theme-btn icon-btn" id="theme-toggle" aria-label="Toggle dark mode" aria-pressed="false">
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </nav>
    </header>
    <!-- ponytail: data-pagefind-body scopes the index to Base-rendered pages; the atlas fork's app.html has none, so it is excluded -->
    <div data-pagefind-body><slot /></div>
    {footer && <footer class="site-footer">
      <!-- ponytail: licence files live at repo root; licence-and-attribution-files story must expose them under public/ or check-links will flag these -->
      <p>
        Code <a href="/LICENSE">MIT</a> ·
        Prose <a href="/LICENSE-content.md">CC BY-SA 4.0</a> ·
        BodyParts3D data <a href="/ATTRIBUTION.md">CC BY 4.0</a>
      </p>
      <p>Spinal Tap teaches; it does not diagnose or replace a clinician. · <a href="/settings/">Settings</a></p>
    </footer>}
  </body>
</html>
<script>
  // The toggle flips whatever is showing now (pinned or OS-derived) and pins the result.
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle')!;
  const os = matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ?? (os.matches ? 'dark' : 'light')) === 'dark';
  const sync = () => btn.setAttribute('aria-pressed', String(isDark()));
  btn.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    sync();
  });
  os.addEventListener('change', sync);
  sync();
</script>
<style>
  .site-nav { position: sticky; top: 0; z-index: 10; height: var(--nav-h); border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  nav { max-width: 72rem; height: 100%; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 1rem; letter-spacing: -0.2px; text-decoration: none; color: var(--text); white-space: nowrap; }
  .mark { width: 18px; height: 18px; border-radius: 6px; background: linear-gradient(180deg, var(--brand) 0 22%, transparent 22% 39%, var(--brand) 39% 61%, transparent 61% 78%, var(--brand) 78%); }
  .links { display: flex; align-items: center; gap: 4px; margin-left: auto; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .links a:not(.btn) { padding: 5px 10px; border-radius: 8px; font-size: 0.875rem; font-weight: 500; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .links a:not(.btn):hover, .links a[aria-current='page'] { color: var(--text); background: var(--hover); }
  .search-btn { margin-left: 8px; padding: 4px 14px; font-size: 0.875rem; }
  .icon-btn { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 0; border-radius: 9999px; color: var(--muted); text-decoration: none; }
  a.icon-btn { background: transparent; border: 0; box-shadow: none; }
  a.icon-btn:hover, a.icon-btn[aria-current='page'] { color: var(--text); background: var(--hover); }
  .theme-btn { margin-left: -6px; color: inherit; }
  .icon-btn svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .theme-btn .sun, .theme-btn[aria-pressed='true'] .moon { display: none; }
  .theme-btn[aria-pressed='true'] .sun { display: block; }
  .site-footer { max-width: var(--content-w); margin: 0 auto; padding: 24px 24px 48px; text-align: center; border-top: 1px solid var(--border-3); font-size: 0.8125rem; color: var(--muted); }
  .site-footer p { margin: 4px 0; }
  .site-footer a { color: var(--muted); }
  @media (max-width: 640px) {
    nav { padding: 0 16px; }
    .search-btn { margin-left: 2px; }
    .links a:not(.btn) { padding: 5px 7px; }
    /* fade the right edge so the scrollable link row reads as scrollable */
    .links { -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); mask-image: linear-gradient(90deg, #000 85%, transparent); padding-right: 24px; }
  }
  @media (max-width: 480px) {
    .logo-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
</style>
