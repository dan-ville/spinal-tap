---
// /review — Checks due now, scheduled by ts-fsrs from the `recall` localStorage blob Check.astro writes.
// Every Check on the site is rendered hidden at build time; the client script unhides and orders the due ones.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const articles = await getCollection('articles', (a) => a.data.status === 'published');
const checks: { id: string; q: string; href: string; article: string }[] = [];
for (const a of articles) {
  // ponytail: regex over the raw MDX; every article Check uses the <Fragment slot="answer"> form.
  for (const m of (a.body ?? '').matchAll(/<Check id="([^"]+)"[^>]*>\s*([\s\S]*?)\s*<Fragment slot="answer">/g)) {
    checks.push({ id: m[1], q: m[2].replace(/[*`_]/g, '').replace(/\s+/g, ' '), href: `/learn/${a.id}/#${m[1]}`, article: a.data.title });
  }
}
---
<Base title="Review">
  <main class="review">
    <p class="crumb"><a href="/">Spinal Tap</a> › review</p>
    <h1>Review</h1>
    <p>Checks you have graded come back here when the scheduler thinks you are about to forget them. Open one, answer it in the article, grade it, and it leaves the queue.</p>

    <h2>Due now <span id="due-count" class="count"></span></h2>
    <p id="due-empty" hidden>Nothing due. Grade some Checks in the articles, or come back later.</p>
    <ol id="due">
      {checks.map((c) => (
        <li data-id={c.id} hidden>
          <a href={c.href}>{c.q}</a>
          <small>{c.article} · <span class="last"></span></small>
        </li>
      ))}
    </ol>

    <h2>Delayed recall over time</h2>
    <p>How often your last answer was correct, by how long you had been away from the item. The right-hand buckets are the ones that matter: recall after a delay is the thing that is being trained.</p>
    <table id="delay">
      <thead><tr><th>Time since previous review</th><th>Items</th><th>Recalled</th></tr></thead>
      <tbody></tbody>
    </table>

    <h2>Your data</h2>
    <p>Everything lives in this browser. Export to keep a copy or move it; import to restore it.</p>
    <p class="actions">
      <button type="button" id="export">Export JSON</button>
      <label>Import file <input type="file" id="import-file" accept="application/json,.json" /></label>
    </p>
    <details>
      <summary>Or paste JSON</summary>
      <textarea id="import-text" rows="6" placeholder='{"disc-anatomy-1": {...}}'></textarea>
    </details>
    <p class="actions">
      <button type="button" data-import="merge">Import and merge</button>
      <button type="button" data-import="replace">Import and replace</button>
      <span id="import-msg" role="status"></span>
    </p>
  </main>
</Base>

<script>
  import { parseRecords, serialise, importRecords } from '../lib/recall';
  import { dueQueue, recallByDelay } from '../lib/schedule';
  const KEY = 'recall';
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const days = (iso: string) => Math.round((Date.now() - Date.parse(iso)) / 86_400_000);

  function render() {
    const set = parseRecords(localStorage.getItem(KEY));
    const list = $('#due');
    const items = new Map([...list.children].map((li) => [(li as HTMLElement).dataset.id!, li as HTMLElement]));
    items.forEach((li) => (li.hidden = true));
    const due = dueQueue(set, new Date()).filter((r) => items.has(r.id));
    for (const r of due) {
      const li = items.get(r.id)!;
      li.hidden = false;
      li.dataset.grade = r.grade;
      li.querySelector('.last')!.textContent =
        `last time ${r.grade}${r.confidence ? ` while ${r.confidence === 'high' ? 'certain' : r.confidence === 'med' ? 'fairly sure' : 'guessing'}` : ''}, ${days(r.reviewedAt)} days ago`;
      list.appendChild(li); // move into queue order
    }
    $('#due-count').textContent = due.length ? `(${due.length})` : '';
    $('#due-empty').hidden = due.length > 0;
    $('#delay tbody').innerHTML = recallByDelay(set)
      .map((b) => `<tr><td>${b.label}</td><td>${b.total}</td><td>${b.total ? `${b.correct} of ${b.total}` : '–'}</td></tr>`)
      .join('');
  }

  function doImport(text: string, mode: 'merge' | 'replace') {
    const incoming = parseRecords(text);
    const n = Object.keys(incoming).length;
    if (!n) { $('#import-msg').textContent = 'No valid records found in that JSON.'; return; }
    localStorage.setItem(KEY, serialise(importRecords(parseRecords(localStorage.getItem(KEY)), incoming, mode)));
    $('#import-msg').textContent = `Imported ${n} record${n === 1 ? '' : 's'} (${mode}).`;
    render();
  }

  $('#export').addEventListener('click', () => {
    const blob = new Blob([localStorage.getItem(KEY) ?? '{}'], { type: 'application/json' });
    const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: `spine-academy-recall-${new Date().toISOString().slice(0, 10)}.json` });
    a.click();
    URL.revokeObjectURL(a.href);
  });
  document.querySelectorAll<HTMLElement>('[data-import]').forEach((b) =>
    b.addEventListener('click', async () => {
      const file = ($('#import-file') as HTMLInputElement).files?.[0];
      doImport(file ? await file.text() : ($('#import-text') as HTMLTextAreaElement).value, b.dataset.import as 'merge' | 'replace');
    }),
  );
  render();
</script>

<style>
  .review { max-width: 44rem; margin: 0 auto; padding: 2rem 1rem; }
  .crumb { color: #6b7280; font-size: 0.9rem; }
  .count { color: #6b7280; font-weight: normal; font-size: 1rem; }
  #due li { margin-bottom: 0.75rem; }
  #due li small { display: block; color: #6b7280; }
  #due li[data-grade='incorrect'] a { color: #b91c1c; }
  table { border-collapse: collapse; }
  td, th { text-align: left; padding: 0.25rem 1rem 0.25rem 0; border-bottom: 1px solid #e5e7eb; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  textarea { width: 100%; font-family: ui-monospace, monospace; }
</style>
