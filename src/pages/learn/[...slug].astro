---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Check from '../../components/Check.astro';
import Callout from '../../components/Callout.astro';
import KeyList from '../../components/KeyList.astro';
import Lede from '../../components/Lede.astro';
import Source from '../../components/Source.astro';
import Structure from '../../components/Structure.astro';
import Evidence from '../../components/Evidence.astro';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all.map((entry) => {
    const siblings = all
      .filter((e) => e.data.track === entry.data.track)
      .sort((a, b) => a.data.order - b.data.order);
    const i = siblings.findIndex((e) => e.id === entry.id);
    const nav = (e?: (typeof all)[number]) => e && { title: e.data.title, href: `/learn/${e.id}/` };
    return { params: { slug: entry.id }, props: { entry, prev: nav(siblings[i - 1]), next: nav(siblings[i + 1]) } };
  });
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---
<Article title={entry.data.title} track={entry.data.track} sources={entry.data.sources} headings={headings} prev={prev} next={next}>
  <Content components={{ Check, Callout, KeyList, Lede, Source, Structure, Evidence }} />
</Article>
