---
import { getCollection } from 'astro:content';
import { parse } from 'yaml';
import Base from '../../layouts/Base.astro';
import raw from '../../content/sources/sources.yml?raw';

const sources = parse(raw) ?? {};
const levels = ['high', 'moderate', 'low', 'very-low'] as const;
const cards = await getCollection('evidence');
---
<Base title="Evidence">
  <main class="evidence-index">
    <p class="crumb"><a href="/">Spinal Tap</a> › evidence</p>
    <h1>Evidence cards</h1>
    <p class="lede">One card per open-access primary source, grouped by certainty of the headline claim.</p>
    {levels.map((level) => {
      const group = cards.filter((c) => c.data.certainty === level);
      return group.length === 0 ? null : (
        <section>
          <h2 class="certainty" data-level={level}>{level.replace('-', ' ')} certainty</h2>
          <ul class="cards">{group.map((c) => {
            const s = sources[c.data.source];
            return (
              <li id={c.id} class="card">
                <strong>{c.data.claim}</strong>
                <p>{c.data.design} · {c.data.population} · {c.data.effect}</p>
                <small><a href={s.url}>{s.author ? `${s.author} ` : ''}({s.year}). {s.title}</a></small>
              </li>
            );
          })}</ul>
        </section>
      );
    })}
  </main>
</Base>
<style>
  .certainty { text-transform: capitalize; display: flex; align-items: center; gap: 10px; }
  .certainty::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--red); }
  .certainty[data-level='high']::before { background: var(--brand); }
  .certainty[data-level='moderate']::before { background: var(--amber); }
  .cards { list-style: none; padding: 0; display: grid; gap: 12px; }
  .cards strong { display: block; font-size: 1.0625rem; line-height: 1.45; }
  .cards p { margin: 8px 0; font-size: 0.875rem; color: var(--muted); }
  .cards small { font-size: 0.8125rem; }
</style>
