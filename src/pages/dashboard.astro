---
// /dashboard — the reader's working surface for the plan: daily check-in journal, gate tracking,
// calculators and a whole-site backup. /plan/ stays read-only and links here.
// Everything persists in localStorage (journal under `journal`, gates under `gate:<id>`).
import { parse } from 'yaml';
import Base from '../layouts/Base.astro';
import Gate from '../components/Gate.astro';
import Calc from '../components/Calc.astro';
import raw from '../data/gates.yml?raw';

const gates = parse(raw) as { phase: number; id: string }[];
const phases = [
  [0, 'Baseline'], [1, 'Capacity floor'], [2, 'Progressive loading'], [3, 'Strength build'], [4, 'Performance'],
] as const;
const CHECKIN_TARGET = 14; // gate p0-checkins-14
---
<Base title="Dashboard">
  <main class="dash">
    <p class="crumb"><a href="/">Spinal Tap</a> › dashboard</p>
    <h1>Dashboard</h1>
    <p class="lede">Log your daily check-in, tick gates as your log shows them met, and run the plan's numbers. The <a href="/plan/">plan</a> explains what each gate means.</p>
    <p class="local-note">Saved in this browser only. Export a backup below to keep a copy or move to another device.</p>

    <section class="stats" aria-label="Summary">
      <div class="stat"><span class="label">Check-in streak</span><strong id="stat-streak">0</strong><small>days · {CHECKIN_TARGET} for the Phase 0 gate</small></div>
      <div class="stat"><span class="label">Gates met</span><strong id="stat-gates">0</strong><small>of {gates.length}</small></div>
      <div class="stat"><span class="label">Current phase</span><strong id="stat-phase">0</strong><small id="stat-phase-name">Baseline</small></div>
      <div class="stat"><span class="label">Last check-in</span><strong id="stat-last">–</strong><small id="stat-last-sub">none yet</small></div>
    </section>

    <div class="modules">
      <section class="module" id="checkin">
        <h2>Daily check-in</h2>
        <p class="hint">Training day or not. Same stiffness test, same time, every morning. Saving a date that already has an entry replaces it.</p>
        <form id="checkin-form" class="fields">
          <label>Date <input type="date" name="date" required /></label>
          <label>Morning stiffness (0–10) <input type="number" name="stiffness" min="0" max="10" step="1" inputmode="numeric" /></label>
          <fieldset><legend>Anything below the glute?</legend>
            <label class="inline"><input type="radio" name="belowGlute" value="no" /> No</label>
            <label class="inline"><input type="radio" name="belowGlute" value="yes" /> Yes</label>
          </fieldset>
          <label>Sleep (hours) <input type="number" name="sleep" min="0" max="24" step="0.5" inputmode="decimal" /></label>
          <label>Life stress (1–5) <input type="number" name="stress" min="1" max="5" step="1" inputmode="numeric" /></label>
          <label>Bodyweight <input type="number" name="bodyweight" min="0" step="any" inputmode="decimal" /></label>
          <label>Walking (minutes) <input type="number" name="walk" min="0" step="1" inputmode="numeric" /></label>
          <label class="wide">Journal <textarea name="note" rows="4" placeholder="Training, how the session felt, anything you want to remember"></textarea></label>
          <p class="wide actions"><button type="submit" class="btn-primary">Save check-in</button><span id="checkin-msg" role="status"></span></p>
        </form>
        <p class="redflag">Saddle numbness, bladder or bowel change, or new weakness: stop and see a clinician today. The <a href="/plan/">plan</a> lists every red flag.</p>
      </section>

      <section class="module" id="journal">
        <h2>Journal <span id="journal-count" class="count"></span></h2>
        <p id="journal-empty" class="hint">No entries yet. Your check-ins appear here, newest first.</p>
        <div class="table-wrap">
          <table id="journal-table" hidden>
            <thead><tr><th>Date</th><th title="Morning stiffness 0–10">Stiff</th><th title="Anything below the glute">Glute↓</th><th>Sleep</th><th>Stress</th><th>BW</th><th>Walk</th><th><span class="sr">Actions</span></th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </section>

      <section class="module span" id="gates">
        <h2>Gates</h2>
        <p class="hint">Tick a gate when your log shows it met, not when you feel it is. Tags name where each number comes from.</p>
        <div class="phases">
          {phases.map(([n, name]) => (
            <div class="phase" data-phase={n}>
              <h3>Phase {n} · {name} <span class="count" data-phase-count={n}></span></h3>
              <div class="bar" aria-hidden="true"><span data-phase-bar={n}></span></div>
              <Gate phase={n} interactive />
            </div>
          ))}
        </div>
      </section>

      <section class="module span" id="calculators">
        <h2>Calculators</h2>
        <p class="hint">The plan's numbers, computed the same way everywhere on the site. Nothing here is saved.</p>
        <div class="calcs">
          <Calc kind="mcgill" />
          <Calc kind="e1rm" />
          <Calc kind="rpe" />
          <Calc kind="hardsets" />
          <Calc kind="dots" />
        </div>
      </section>

      <section class="module span" id="data">
        <h2>Your data</h2>
        <p class="hint">One file holds your journal, gate ticks, review history and article notes. Importing a backup overwrites those keys in this browser.</p>
        <p class="actions">
          <button type="button" id="backup-export">Export backup</button>
          <button type="button" id="journal-csv">Journal as CSV</button>
          <label class="file">Restore from file <input type="file" id="backup-file" accept="application/json,.json" /></label>
          <span id="backup-msg" role="status"></span>
        </p>
      </section>
    </div>
  </main>
</Base>

<script>
  import { parseJournal, toEntry, upsertEntry, deleteEntry, newestFirst, streak, localDate, makeBackup, readBackup } from '../lib/journal';
  import type { Entry } from '../lib/journal';
  const KEY = 'journal';
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector(s) as T;
  const load = () => parseJournal(localStorage.getItem(KEY));
  const save = (j: ReturnType<typeof load>) => localStorage.setItem(KEY, JSON.stringify(j));
  const cell = (v: number | null) => (v == null ? '–' : String(v));
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&${({ '&': 'amp', '<': 'lt', '>': 'gt', '"': 'quot' } as const)[c as '&']};`);
  const download = (name: string, type: string, body: string) => {
    const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(new Blob([body], { type })), download: name });
    a.click();
    URL.revokeObjectURL(a.href);
  };
  const today = () => localDate(new Date());
  const phaseNames = ['Baseline', 'Capacity floor', 'Progressive loading', 'Strength build', 'Performance'];

  function renderJournal() {
    const entries = newestFirst(load());
    $('#journal-empty').hidden = entries.length > 0;
    $('#journal-table').hidden = entries.length === 0;
    $('#journal-count').textContent = entries.length ? `(${entries.length})` : '';
    $('#journal-table tbody').innerHTML = entries.map((e: Entry) => `
      <tr data-date="${e.date}">
        <td><button type="button" class="link" data-edit="${e.date}">${e.date}</button></td>
        <td>${cell(e.stiffness)}</td><td>${e.belowGlute == null ? '–' : e.belowGlute ? '<b class="yes">yes</b>' : 'no'}</td>
        <td>${cell(e.sleep)}</td><td>${cell(e.stress)}</td><td>${cell(e.bodyweight)}</td><td>${cell(e.walk)}</td>
        <td><button type="button" class="link danger" data-delete="${e.date}" aria-label="Delete ${e.date}">Delete</button></td>
      </tr>${e.note ? `<tr class="note"><td colspan="8">${esc(e.note)}</td></tr>` : ''}`).join('');
    const s = streak(load());
    $('#stat-streak').textContent = String(s);
    $('#stat-last').textContent = entries[0]?.date.slice(5) ?? '–';
    $('#stat-last-sub').textContent = entries[0] ? (entries[0].date === today() ? 'today' : entries[0].date.slice(0, 4)) : 'none yet';
  }

  function renderGates() {
    const boxes = [...document.querySelectorAll<HTMLInputElement>('input[data-gate]')];
    const met = boxes.filter((b) => b.checked).length;
    $('#stat-gates').textContent = String(met);
    let current = 4;
    for (let n = 4; n >= 0; n--) {
      const mine = boxes.filter((b) => b.closest<HTMLElement>('.phase')!.dataset.phase === String(n));
      const done = mine.filter((b) => b.checked).length;
      document.querySelector(`[data-phase-count="${n}"]`)!.textContent = `${done}/${mine.length}`;
      (document.querySelector(`[data-phase-bar="${n}"]`) as HTMLElement).style.width = `${mine.length ? (100 * done) / mine.length : 0}%`;
      if (done < mine.length) current = n; // the lowest phase with an open gate
    }
    $('#stat-phase').textContent = String(current);
    $('#stat-phase-name').textContent = phaseNames[current];
  }

  function fill(e?: Entry) {
    const f = $<HTMLFormElement>('#checkin-form');
    f.reset();
    (f.elements.namedItem('date') as HTMLInputElement).value = e?.date ?? today();
    if (!e) return;
    for (const k of ['stiffness', 'sleep', 'stress', 'bodyweight', 'walk'] as const)
      (f.elements.namedItem(k) as HTMLInputElement).value = e[k] == null ? '' : String(e[k]);
    (f.elements.namedItem('note') as HTMLTextAreaElement).value = e.note;
    if (e.belowGlute != null) (f.querySelector(`input[name="belowGlute"][value="${e.belowGlute ? 'yes' : 'no'}"]`) as HTMLInputElement).checked = true;
  }

  $('#checkin-form').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const e = toEntry(Object.fromEntries(new FormData(ev.target as HTMLFormElement)));
    if (!e) return;
    const j = load();
    const replaced = !!j[e.date];
    save(upsertEntry(j, e));
    $('#checkin-msg').textContent = `${replaced ? 'Updated' : 'Saved'} ${e.date}.`;
    renderJournal();
  });
  $('#checkin-form').addEventListener('change', (ev) => {
    // picking a date that already has an entry loads it for editing
    const t = ev.target as HTMLInputElement;
    if (t.name === 'date') { const e = load()[t.value]; if (e) fill(e); $('#checkin-msg').textContent = e ? `Editing ${e.date}.` : ''; }
  });
  $('#journal-table').addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest('button');
    if (!b) return;
    if (b.dataset.edit) { fill(load()[b.dataset.edit]); $('#checkin-msg').textContent = `Editing ${b.dataset.edit}.`; $('#checkin').scrollIntoView({ behavior: 'smooth' }); }
    if (b.dataset.delete && confirm(`Delete the check-in for ${b.dataset.delete}?`)) { save(deleteEntry(load(), b.dataset.delete)); renderJournal(); }
  });

  $('#backup-export').addEventListener('click', () => {
    const pairs = Object.keys(localStorage).map((k) => [k, localStorage.getItem(k) ?? ''] as [string, string]);
    download(`spinal-tap-backup-${today()}.json`, 'application/json', JSON.stringify(makeBackup(pairs), null, 2));
  });
  $('#journal-csv').addEventListener('click', () => {
    const cols = ['date', 'stiffness', 'belowGlute', 'sleep', 'stress', 'bodyweight', 'walk', 'note'] as const;
    const q = (v: unknown) => (v == null ? '' : /[",\n]/.test(String(v)) ? `"${String(v).replace(/"/g, '""')}"` : String(v));
    const rows = newestFirst(load()).reverse().map((e) => cols.map((c) => q(e[c])).join(','));
    download(`spinal-tap-journal-${today()}.csv`, 'text/csv', [cols.join(','), ...rows].join('\n'));
  });
  $<HTMLInputElement>('#backup-file').addEventListener('change', async (ev) => {
    const file = (ev.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const pairs = readBackup(await file.text());
    if (!pairs.length) { $('#backup-msg').textContent = 'That file is not a Spinal Tap backup.'; return; }
    if (!confirm(`Restore ${pairs.length} saved item${pairs.length === 1 ? '' : 's'}? Matching data in this browser is overwritten.`)) return;
    for (const [k, v] of pairs) localStorage.setItem(k, v);
    location.reload();
  });

  document.addEventListener('gates-changed', renderGates);
  fill();
  renderJournal();
  renderGates();
</script>

<style>
  .dash { max-width: 72rem; }
  .local-note { margin: -1rem 0 2rem; font-size: 0.875rem; color: var(--faint); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 12px; margin-bottom: 16px; }
  .stat { display: flex; flex-direction: column; gap: 2px; padding: 16px 20px; border: 1px solid var(--border-2); border-radius: 16px; background: var(--surface); box-shadow: var(--shadow); }
  .stat strong { font: 600 1.75rem/1.2 var(--mono); color: var(--text); font-variant-numeric: tabular-nums; }
  .stat small { font-size: 0.8125rem; color: var(--muted); }
  .modules { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: 16px; }
  .module { min-width: 0; padding: 20px 24px; border: 1px solid var(--border-2); border-radius: 16px; background: var(--surface); box-shadow: var(--shadow); }
  .module.span { grid-column: 1 / -1; }
  .module h2 { margin: 0 0 4px; font-size: 1.25rem; }
  .hint { margin: 0 0 16px; font-size: 0.875rem; color: var(--muted); }
  .count { font: 500 0.75rem/1.5 var(--mono); color: var(--muted); margin-left: 6px; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
  .fields label:not(.inline) { display: flex; flex-direction: column; gap: 4px; font-size: 0.875rem; font-weight: 500; color: var(--text-2); }
  .fields input:not([type='radio']) { width: 100%; }
  .fields .wide { grid-column: 1 / -1; }
  fieldset { border: 0; padding: 0; margin: 0; font-size: 0.875rem; font-weight: 500; }
  legend { padding: 0; margin-bottom: 6px; }
  .inline { display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; font-weight: 400; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; margin: 0; }
  [role='status'] { font-size: 0.875rem; color: var(--brand-deep); }
  .redflag { margin: 16px 0 0; padding: 10px 14px; border-radius: 12px; background: var(--red-light); font-size: 0.8125rem; }
  .table-wrap { overflow-x: auto; }
  #journal-table { font-size: 0.875rem; }
  #journal-table th, #journal-table td { padding: 8px 12px 8px 0; white-space: nowrap; }
  /* rows are built with innerHTML, so they carry no scoping attribute: style them through :global */
  #journal-table :global(tr:has(+ .note) td) { border-bottom: 0; }
  #journal-table :global(.note td) { padding-top: 0; white-space: normal; color: var(--muted); font-size: 0.8125rem; }
  #journal-table :global(.yes) { color: var(--red); }
  #journal-table :global(button.link) { padding: 0; border: 0; background: none; box-shadow: none; font: inherit; color: var(--text); text-decoration: underline; text-decoration-color: var(--brand); text-underline-offset: 3px; border-radius: 0; }
  #journal-table :global(button.link.danger) { color: var(--muted); text-decoration-color: var(--red); font-size: 0.8125rem; }
  .phases { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 8px 32px; }
  .phase h3 { margin: 8px 0 6px; font-size: 1rem; }
  .bar { height: 4px; border-radius: 9999px; background: var(--hover); overflow: hidden; }
  .bar span { display: block; height: 100%; width: 0; background: var(--brand); transition: width 0.2s; }
  .phase :global(.gates) { font-size: 0.9375rem; }
  .calcs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 0 16px; align-items: start; }
  .calcs :global(.calc) { margin: 0 0 16px; }
  .file { display: inline-flex; align-items: center; gap: 8px; font-size: 0.875rem; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 480px) { .fields { grid-template-columns: 1fr; } }
</style>
