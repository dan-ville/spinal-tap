---
// ponytail: the atlas is an iframe, not a React island — no @astrojs/react. The fork's entry is
// renamed to app.html by build:atlas so this page can own /atlas/ without clobbering it.
import Base from '../layouts/Base.astro';
---
<Base title="Atlas" footer={false}>
  <main class="atlas-page">
    <iframe id="atlas" src="/atlas/app.html" title="Human Atlas: interactive 3D anatomy of the lumbar spine, pelvis and hip"></iframe>
    <footer class="attribution">
      3D models from <a href="https://lifesciencedb.jp/bp3d/">BodyParts3D</a>, © The Database Center for Life Science, CC BY 4.0,
      via the <a href="https://github.com/ashemag/human-atlas">human-atlas</a> fork. Full credits in <a href="/ATTRIBUTION.md">ATTRIBUTION.md</a>.
      Spinal Tap teaches; it does not diagnose or replace a clinician.
    </footer>
  </main>
</Base>
<script>
  // Forward ?focus=… (and any other query) to the embedded app; set src once to avoid a double load.
  if (location.search) {
    const f = document.getElementById('atlas') as HTMLIFrameElement;
    f.src = '/atlas/app.html' + location.search;
  }
</script>
<style>
  /* nav + iframe + attribution = 100dvh, so the page itself never scrolls; the atlas scrolls inside its frame */
  :global(html), :global(body) { height: 100%; overflow: hidden; }
  .atlas-page { max-width: none; padding: 0; display: flex; flex-direction: column; height: calc(100dvh - var(--nav-h)); }
  iframe { flex: 1; min-height: 0; width: 100%; border: 0; background: #f3f4f4; }
  .attribution { flex: none; margin: 0; padding: 8px 24px; border-top: 1px solid var(--border); text-align: center; font-size: 0.75rem; line-height: 1.5; color: var(--muted); }
  .attribution a { color: var(--muted); }
</style>
