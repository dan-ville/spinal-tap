---
// ponytail: the atlas is an iframe, not a React island — no @astrojs/react. The fork's entry is
// renamed to app.html by build:atlas so this page can own /atlas/ without clobbering it.
import Base from '../layouts/Base.astro';
---
<Base title="Atlas">
  <main class="atlas-page">
    <iframe id="atlas" src="/atlas/app.html" title="Human Atlas: interactive 3D anatomy of the lumbar spine, pelvis and hip"></iframe>
    <p class="attribution">
      3D models from <a href="https://lifesciencedb.jp/bp3d/">BodyParts3D</a>, © The Database Center for Life Science, licensed under CC BY 4.0,
      via the <a href="https://github.com/ashemag/human-atlas">human-atlas</a> fork. Full credits in <a href="/ATTRIBUTION.md">ATTRIBUTION.md</a>.
    </p>
  </main>
</Base>
<script>
  // Forward ?focus=… (and any other query) to the embedded app; set src once to avoid a double load.
  if (location.search) {
    const f = document.getElementById('atlas') as HTMLIFrameElement;
    f.src = '/atlas/app.html' + location.search;
  }
</script>
<style>
  .atlas-page { display: flex; flex-direction: column; height: calc(100vh - 7rem); }
  iframe { flex: 1; width: 100%; border: 0; min-height: 60vh; }
  .attribution { margin: 0.5rem 1rem; font-size: 0.85rem; color: #6b7280; }
</style>
