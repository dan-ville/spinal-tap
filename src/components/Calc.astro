---
// Deterministic calculator widget (docs/plan.md §2 "Deterministic numbers"). Usage in MDX (no import needed):
//   <Calc kind="mcgill" />   four hold times → McGill ratios + §4 gate verdicts
//   <Calc kind="e1rm" />     weight × reps → Epley estimated 1RM
//   <Calc kind="dots" />     total, bodyweight, sex → DOTS points
//   <Calc kind="torque" />   mass × horizontal moment arm → moment in N·m
// All maths lives in src/lib/calc.ts; this file only wires inputs to outputs client-side.
interface Props { kind: 'mcgill' | 'e1rm' | 'dots' | 'torque' }
const { kind } = Astro.props;
const fields: Record<Props['kind'], [name: string, label: string][]> = {
  mcgill: [['flexor', 'Trunk flexor hold (s)'], ['extensor', 'Extensor hold (s)'], ['bridgeL', 'Side bridge L (s)'], ['bridgeR', 'Side bridge R (s)']],
  e1rm: [['weight', 'Weight'], ['reps', 'Reps']],
  dots: [['total', 'Total (kg)'], ['bodyweight', 'Bodyweight (kg)']],
  torque: [['mass', 'Load (kg)'], ['arm', 'Horizontal moment arm (cm)']],
};
const titles = { mcgill: 'McGill endurance ratios', e1rm: 'Estimated 1RM (Epley)', dots: 'DOTS', torque: 'Moment about the lumbar spine' };
---
<form class="calc" data-kind={kind} aria-label={titles[kind]}>
  <div class="calc-head">Calc · {titles[kind]}</div>
  {fields[kind].map(([name, label]) => (
    <label>{label} <input type="number" name={name} min="0" step="any" inputmode="decimal" /></label>
  ))}
  {kind === 'dots' && (
    <label>Sex <select name="sex"><option value="male">Male</option><option value="female">Female</option></select></label>
  )}
  <output class="calc-out" aria-live="polite">Enter values above.</output>
</form>

<script>
  import { mcgillRatios, e1rm, dots, torque } from '../lib/calc';
  const f1 = (n: number) => n.toFixed(1);
  const f2 = (n: number) => n.toFixed(2);
  const verdict = (ok: boolean) => (ok ? 'pass' : 'not yet');

  const render: Record<string, (v: Record<string, string>) => string> = {
    mcgill: (v) => {
      const r = mcgillRatios({ flexor: +v.flexor, extensor: +v.extensor, bridgeL: +v.bridgeL, bridgeR: +v.bridgeR });
      return [
        `Flexor/extensor ${f2(r.flexorExtensor)} (gate < 1.0: ${verdict(r.gates.flexorExtensor)})`,
        `Side bridge/extensor ${f2(r.bridgeExtensor)} (gate ≈ 0.75: ${verdict(r.gates.bridgeExtensor)})`,
        `L/R asymmetry ${f1(r.asymmetryPct)}% (gate ≤ 5%: ${verdict(r.gates.symmetry)})`,
      ].join('\n');
    },
    e1rm: (v) => `Estimated 1RM ${f1(e1rm(+v.weight, +v.reps))}`,
    dots: (v) => `DOTS ${f1(dots(+v.total, +v.bodyweight, v.sex as 'male' | 'female'))}`,
    torque: (v) => `Moment ${f1(torque(+v.mass, +v.arm))} N·m (load ${f1(+v.mass * 9.81)} N × arm ${f2(+v.arm / 100)} m)`,
  };

  document.addEventListener('input', (e) => {
    const form = (e.target as HTMLElement).closest('form.calc') as HTMLFormElement | null;
    if (!form) return;
    const v = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const out = form.querySelector('.calc-out') as HTMLOutputElement;
    const missing = [...form.querySelectorAll<HTMLInputElement>('input')].some((i) => i.value === '' || +i.value <= 0);
    out.textContent = missing ? 'Enter values above.' : render[form.dataset.kind!](v);
  });
</script>

<style>
  .calc { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding: 1rem; border: 1px solid #ccc; border-radius: 6px; }
  .calc-head { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.7; }
  .calc label { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  .calc input, .calc select { width: 8rem; }
  .calc-out { white-space: pre-line; font-variant-numeric: tabular-nums; padding-top: 0.5rem; border-top: 1px solid #eee; }
</style>
