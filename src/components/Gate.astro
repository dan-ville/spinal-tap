---
// A plan phase's exit gates (docs/plan.md §4), read from src/data/gates.yml. Read-only: readers track
// gates in the downloadable tracker (/templates/), whose Gates sheet is generated from the same file.
//   <Gate phase={1} />
// Each gate shows the measurement, a plain-language reading of it (`plain`), and a provenance badge:
// a linked source from sources.yml, or the plain label for [heuristic] / [proposed].
import { parse } from 'yaml';
import raw from '../data/gates.yml?raw';
import Tag from './Tag.astro';
interface Gate { phase: number; id: string; text: string; plain?: string; source?: string; tag?: 'heuristic' | 'proposed' }
interface Props { phase: number }
const { phase } = Astro.props;
const gates = (parse(raw) as Gate[]).filter((g) => g.phase === phase);
const n = gates.length;
// The site stores nothing, so the wording points at the reader's own tracker, never at the page.
const intro = phase === 4
  ? 'No exit. Keep this one going for as long as the plan runs.'
  : n === 1
    ? `Tick this off in your tracker when it is true. Phase ${phase + 1} starts then.`
    : `Tick these off in your tracker as they become true. Phase ${phase + 1} starts when all ${n} are ticked.`;
---
<p class="gates-intro">{intro}</p>
<ol class="gates">
  {gates.map((g) => (
    <li id={g.id}>
      <span class="gate-text">{g.text}</span>
      {g.plain && <span class="gate-plain">{g.plain}</span>}
      <span class="gate-tag">{g.source ? <Tag source={g.source} /> : <Tag kind={g.tag!} />}</span>
    </li>
  ))}
</ol>

<style>
  .gates-intro { margin: 0.75rem 0 0.5rem; font-size: 0.9375rem; color: var(--muted); }
  .gates { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 8px; counter-reset: g; }
  .gates li { counter-increment: g; position: relative; display: grid; gap: 4px; padding: 12px 16px 12px 48px; border: 1px solid var(--border-2); border-radius: 12px; background: var(--surface); box-shadow: var(--shadow); }
  .gates li::before { content: counter(g); position: absolute; left: 16px; top: 13px; width: 20px; height: 20px; border-radius: 50%; background: var(--brand-light); color: var(--brand-deep); font: 600 0.75rem/20px var(--mono); text-align: center; }
  .gate-text { color: var(--text); font-weight: 500; }
  .gate-plain { font-size: 0.9375rem; color: var(--muted); }
  .gate-tag { margin-top: 2px; }
  @media (max-width: 640px) {
    .gates li { padding: 12px 14px 12px 42px; }
    .gates li::before { left: 12px; }
  }
</style>
