---
// A plan phase's exit gates (docs/plan.md §4), read from src/data/gates.yml. Read-only: readers track
// gates in the downloadable tracker (/templates/), whose Gates sheet is generated from the same file.
//   <Gate phase={1} />
// Each gate shows its provenance: a source id from sources.yml, or [heuristic] / [proposed].
import { parse } from 'yaml';
import raw from '../data/gates.yml?raw';
interface Gate { phase: number; id: string; text: string; source?: string; tag?: 'heuristic' | 'proposed' }
interface Props { phase: number }
const { phase } = Astro.props;
const gates = (parse(raw) as Gate[]).filter((g) => g.phase === phase);
---
<ul class="gates">
  {gates.map((g) => (
    <li id={g.id}>
      <span class="gate-text">{g.text}</span>
      <small class="gate-tag" title={g.source ? 'source id in sources.yml' : 'no measured source; a labelled opening position'}>{g.source ? `[${g.source}]` : `[${g.tag}]`}</small>
    </li>
  ))}
</ul>

<style>
  .gates { list-style: none; padding: 0; margin: 0.75rem 0 1.5rem; }
  .gates li { position: relative; display: grid; padding: 0.35rem 0 0.35rem 1.4rem; }
  .gates li::before { content: ''; position: absolute; left: 0.2rem; top: 0.85rem; width: 0.45rem; height: 0.45rem; background: var(--brand); border-radius: 50%; }
  .gate-tag { overflow-wrap: anywhere; }
</style>
