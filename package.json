{
  "name": "spine-academy",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:atlas && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:sources": "node scripts/check-sources.mjs",
    "check:links": "node scripts/check-links.mjs",
    "build:atlas": "npm --prefix atlas run build && rm -rf public/atlas && cp -R atlas/dist public/atlas"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "astro": "^5.18.2"
  }
}
